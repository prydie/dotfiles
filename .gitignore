build.log
venv/
.nvimlog
*/__pycache__/*
__pycache__/
*.py[cod]
/codex/*
!/codex/AGENTS.md
.superpowers/
/config/nks-dev/env
/config/nks-dev/*.local
/config/mise/config.local.toml
# ~/.claude/settings.json is machine-local and accumulates secrets/permissions —
# never publish it (this repo is public). The hq sidebar hooks are injected into
# whatever local settings.json exists by hooks/claude/install-hooks instead.
/claude/settings.json

# Machine-local ci-remote host overrides (may name private hosts).
/config/ci-remote/hosts.local.conf

# Real nscale CLI profiles name internal organizations, projects and regions, so
# only the *.example shapes are tracked. The live ones belong in
# ~/.config/nscale/profiles.d/ (see config/nscale/profiles.d/README.example).
/config/nscale/profiles.d/*.env

# Machine-local litellm proxy config names the internal GLM endpoint; only the
# *.example shapes are tracked (config/litellm/*.example). The live ones belong
# in ~/.config/litellm/ (see config/litellm/env.example).
/config/litellm/config.yaml
/config/litellm/env
