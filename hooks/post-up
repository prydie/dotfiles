#!/usr/bin/env bash
# vim: set ft=sh:

set -euo pipefail

_ROOT="$(dirname "${BASH_SOURCE[0]}")/.."

# Setup options:
# - PROFILE=link|core|dev|full (default: link)
# - SHELL_DEFAULT=1|0 (default: 1)
# - NODE_VERSION=<version> (default: lts/*)
PROFILE="${PROFILE:-link}"
SHELL_DEFAULT="${SHELL_DEFAULT:-1}"
NODE_VERSION="${NODE_VERSION:-lts/*}"
# hooks/os reads NVM_NODE_VERSION; map from the public interface.
export NVM_NODE_VERSION="${NODE_VERSION}"

touch "$HOME/.psqlrc.local"

. "${_ROOT}/hooks/os"

os::get_distro
case "${PROFILE}" in
  link|core|dev|full)
    ;;
  *)
    log::e "Unknown PROFILE=${PROFILE}. Supported: link, core, dev, full"
    exit 1
    ;;
esac

# Install Ghostty's terminfo on every profile (including link) so SSHing into
# this host from a Ghostty terminal does not break tmux/vim. User-level, cheap.
os::ghostty::install_terminfo || true

# Wire the hq mission-control sidebar hooks into the LOCAL agent configs. Both
# files are intentionally untracked (public repo, hold secrets/account settings) —
# see hooks/{claude,codex}/install-hooks. User-level and cheap, so run on every
# profile. (Codex additionally needs a one-time interactive trust on next launch.)
bash "${_ROOT}/hooks/claude/install-hooks" || log::f "hq claude hook install skipped"
bash "${_ROOT}/hooks/codex/install-hooks" || log::f "hq codex hook install skipped"

if [[ "${PROFILE}" != "link" ]]; then
  if [[ "${DISTRO}" =~ ^(Ubuntu|debian)$ ]]; then
    os::ensure_zsh

    if [[ "${SHELL_DEFAULT}" == "1" ]]; then
      os::ensure_user_shell_zsh
    else
      log::f "Skipping login shell update (set SHELL_DEFAULT=1 to enable)"
    fi

    log::f "Running setup profile=${PROFILE}"
    os::ubuntu::install_packages_core

    if [[ "${PROFILE}" == "dev" || "${PROFILE}" == "full" ]]; then
      os::ubuntu::install_packages_dev
    fi
  else
    log::e "Unsupported distribution ${DISTRO}"
    exit 1
  fi
else
  log::f "Profile link selected: skipping host package/tool installation"

  if [[ "${SHELL_DEFAULT}" == "1" ]]; then
    if command -v zsh >/dev/null 2>&1; then
      os::ensure_user_shell_zsh
    else
      log::f "Skipping login shell update: zsh not installed (use PROFILE=core or above)"
    fi
  else
    log::f "Skipping login shell update (set SHELL_DEFAULT=1 to enable)"
  fi
fi

if [[ "${PROFILE}" != "link" ]]; then
  # install antidote if not installed
  if [ ! -d "$HOME/.antidote" ]; then
    git clone --depth=1 https://github.com/mattmc3/antidote "$HOME/.antidote"
  fi
  if [ -s "$HOME/.antidote/antidote.zsh" ]; then
    if command -v zsh >/dev/null 2>&1; then
      # Clone plugins non-interactively so shell setup is fully bootstrapped.
      zsh -lc 'source "$HOME/.antidote/antidote.zsh"; antidote bundle <"$HOME/.zsh_plugins.txt" >/dev/null' || true
    else
      log::f "Skipping antidote bootstrap: zsh not installed"
    fi
  fi

  tools::install_tmux_plugins
else
  log::f "Skipping antidote/TPM bootstrap for PROFILE=link"
fi

if [ -f "$HOME/.config/zoomus.conf" ]; then
  os::set_zoom_scaling_factor
fi

if [[ "${PROFILE}" == "dev" || "${PROFILE}" == "full" ]]; then
  . "${_ROOT}/hooks/nvim"
else
  log::f "Skipping Neovim bootstrap (requires PROFILE=dev|full)"
fi

# Provision the mattpocock/skills pilot subset (grill-me, grill-with-docs, …) for
# Claude Code + Codex so every machine shares one skill set from the same source of
# truth (AI_SKILLS in hooks/os), instead of it living only wherever `make ai-skills`
# happened to be run. Needs npx (dev|full installs Node); the function self-guards
# on npx and this never aborts the bootstrap. Also reachable standalone: make ai-skills.
if [[ "${PROFILE}" == "dev" || "${PROFILE}" == "full" ]]; then
  tools::install_ai_skills || log::f "AI skills install skipped"
else
  log::f "Skipping AI skills install (requires PROFILE=dev|full)"
fi

# Skills authored in this repo (skills/<name>/SKILL.md) into both Claude Code and
# Codex. Unlike the third-party set this needs no npx and no network, so it runs
# on every profile -- a `make up` on a fresh box gets them even at PROFILE=link.
tools::install_local_skills || log::f "Local skills install skipped"

if [[ "${PROFILE}" == "full" ]]; then
  tools::full_install
else
  log::f "Skipping full tool installation (requires PROFILE=full)"
fi
