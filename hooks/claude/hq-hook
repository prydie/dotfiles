#!/usr/bin/env bash
# Claude / Codex hook for the `hq` mission-control sidebar.
#
# Claude paints a leading glyph in its pane title (braille spinner = working,
# ✳ = idle) that `hq` reads directly, but a title can't express "blocked, waiting
# on you". Codex paints no state glyph at all (its title is a session UUID). So
# this hook maintains a small set of per-pane latch files that `hq` reads to fill
# both gaps: a "needs you" latch, plus — for Codex, which has no title signal — a
# "busy" (turn in flight) marker and a captured friendly "name".
#
# Wired per-event: Claude in ~/.claude/settings.json (hooks/claude/install-hooks),
# Codex in ~/.codex/config.toml (hooks/codex/install-hooks). The 1st arg is the
# intended action:
#   needs   an attention Notification fired (permission / decision prompt)
#   clear   Claude forward progress (prompt / tool / turn end / session start)
#   busy    Codex turn in flight (prompt submitted, a tool ran); also captures name
#   idle    Codex turn ended (Stop) — no longer working
#   start   Codex session started — clean slate for this pane
#   end     the session ended in this pane
#
# The latches are keyed by host + tmux pane id, matching how `hq` joins panes to
# state, so they are naturally scoped and self-cleaning as panes come and go.
set -euo pipefail

action=${1:-}
pane=${TMUX_PANE:-}
[[ -z $pane ]] && exit 0 # not inside tmux → the sidebar can't join to this agent

host=$(hostname -s 2>/dev/null || hostname)
dir="${XDG_STATE_HOME:-$HOME/.local/state}/agent-hq/state"
key="${host}-${pane//%/p}" # %22 → p22, a safe filename fragment
latch="${dir}/${key}.needs"
ack="${dir}/${key}.ack"
busy="${dir}/${key}.busy"
name="${dir}/${key}.name"

changed=0
case "$action" in
  needs)
    # Capture the notification text (stdin carries the hook JSON); best-effort.
    msg=$(jq -r '.message // empty' 2>/dev/null <&0 || true)
    # The generic ~60s idle nudge ("Claude is waiting for your input") fires for
    # ANY idle session — including an agent deliberately parked on a background
    # task that will auto-resume. That is not a genuine "needs you", so don't latch
    # red for it; reserve the latch for real blocks (permission/decision prompts).
    case "${msg,,}" in
      *"waiting for your input"*) exit 0 ;;
    esac
    mkdir -p "$dir"
    [[ -f $latch ]] || changed=1
    printf '%s\n' "$msg" >"$latch"
    ;;
  busy)
    # Codex turn in flight: mark the pane working (Codex has no title glyph for
    # `hq` to read). Forward progress also resolves any prior block — an approval
    # was granted or a new prompt started — so clear the needs/ack latches (that
    # DOES change the badge, so flag it for a status repaint).
    mkdir -p "$dir"
    : >"$busy"
    { [[ -f $latch ]] || [[ -f $ack ]]; } && changed=1
    rm -f "$latch" "$ack"
    # UserPromptSubmit carries the prompt; capture its first line as a friendly
    # label (Codex's pane title is a bare UUID). PostToolUse has no prompt → skip,
    # keeping the name from the turn's opening prompt.
    prompt=$(jq -r '.prompt // empty' 2>/dev/null <&0 || true)
    [[ -n $prompt ]] && printf '%s\n' "${prompt%%$'\n'*}" >"$name"
    ;;
  idle)
    # Codex turn ended (Stop): no longer working, and any block is resolved. Keep
    # the captured name so the agent stays labelled while it sits idle.
    { [[ -f $latch ]] || [[ -f $ack ]]; } && changed=1
    rm -f "$busy" "$latch" "$ack"
    ;;
  start | end)
    # Clean slate for this pane: a Codex session started or ended. Drop everything,
    # including the captured name (a fresh session gets its own on first prompt).
    { [[ -f $latch ]] || [[ -f $ack ]]; } && changed=1
    rm -f "$busy" "$name" "$latch" "$ack"
    ;;
  clear)
    # Claude forward progress. Drop the needs latch and any "acknowledged" (muted)
    # flag: the agent has made progress, so a fresh block should re-alert as red.
    # (Claude working/idle comes from its title, so there is no '.busy' to touch.)
    { [[ -f $latch ]] || [[ -f $ack ]]; } && changed=1
    rm -f "$latch" "$ack"
    ;;
  *)
    exit 0
    ;;
esac

# Only when the latch actually changed, nudge tmux to repaint the status bar so
# the "need you" badge updates immediately instead of waiting for status-interval.
# Skipping the no-op case keeps the frequent PostToolUse "clear" from spamming
# status redraws (which would reintroduce the flicker we just designed out).
if ((changed)); then
  tmux refresh-client -S 2>/dev/null || true
fi
exit 0
