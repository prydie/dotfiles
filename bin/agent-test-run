#!/bin/sh

set -efu

usage() {
    echo "usage: agent-test-run [--heavy] COMMAND [ARGUMENT ...]" >&2
}

heavy=false
nested=false
command_arg_offset=2
while [ "$#" -gt 0 ]; do
    case "$1" in
        --heavy)
            heavy=true
            command_arg_offset=$((command_arg_offset + 1))
            shift
            ;;
        --nested)
            nested=true
            command_arg_offset=$((command_arg_offset + 1))
            shift
            ;;
        *)
            break
            ;;
    esac
done

if [ "$#" -eq 0 ]; then
    usage
    exit 2
fi

if ! command -v systemctl >/dev/null 2>&1 || ! command -v systemd-run >/dev/null 2>&1; then
    echo "agent-test-run: systemd user tools are required" >&2
    exit 1
fi

quota=$(systemctl --user show nks-agent-tests.slice \
    --property=CPUQuotaPerSecUSec \
    --value 2>/dev/null) || {
    echo "agent-test-run: nks-agent-tests.slice is unavailable; run 'systemctl --user daemon-reload'" >&2
    exit 1
}
memory_max=$(systemctl --user show nks-agent-tests.slice \
    --property=MemoryMax \
    --value 2>/dev/null) || {
    echo "agent-test-run: nks-agent-tests.slice is unavailable; run 'systemctl --user daemon-reload'" >&2
    exit 1
}
case "$quota" in
    "" | "[not set]" | infinity)
        echo "agent-test-run: nks-agent-tests.slice does not have a finite CPU limit" >&2
        exit 1
        ;;
esac
case "$memory_max" in
    "" | "[not set]" | infinity)
        echo "agent-test-run: nks-agent-tests.slice does not have a finite memory limit" >&2
        exit 1
        ;;
esac

if ! command -v "$1" >/dev/null 2>&1; then
    echo "agent-test-run: command not found: $1" >&2
    exit 127
fi

agent_test_go_flags=${NKS_AGENT_TEST_GO_FLAGS_HELPER:-$(readlink -f \
    "$(dirname "$(readlink -f "$0")")/../libexec/agent-test-go-flags")}
if [ ! -x "$agent_test_go_flags" ]; then
    echo "agent-test-run: Go flag classifier is unavailable: $agent_test_go_flags" >&2
    exit 1
fi

tags_include_remote() {
    tag_list=$1
    saved_ifs=$IFS
    IFS=,
    # Split the comma-delimited Go tag list; glob expansion is disabled above.
    # shellcheck disable=SC2086
    set -- $tag_list
    IFS=$saved_ifs
    for tag do
        case "$tag" in
            integration | chaos)
                return 0
                ;;
        esac
    done
    return 1
}

command_is_remote_only() {
    program=${1##*/}
    if [ "$program" = go ] && [ -n "${GOFLAGS:-}" ] &&
        "$agent_test_go_flags" remote "$GOFLAGS"; then
        return 0
    fi

    expect_tags=false
    for argument do
        if [ "$expect_tags" = true ]; then
            if tags_include_remote "$argument"; then
                return 0
            fi
            expect_tags=false
        fi

        base=${argument##*/}
        case "$base" in
            tlc | tlc2.TLC)
                return 0
                ;;
        esac
        case "$argument" in
            *tlc2.TLC* | *tla2tools*.jar | test-integration | test-chaos | \
                ./test/integration | ./test/integration/* | \
                ../test/integration | ../test/integration/* | \
                test/integration | test/integration/* | \
                ./test/chaos | ./test/chaos/* | \
                ../test/chaos | ../test/chaos/* | \
                test/chaos | test/chaos/* | \
                */test/integration | */test/integration/* | \
                */test/chaos | */test/chaos/*)
                return 0
                ;;
            -tags=* | --tags=*)
                tag_list=${argument#*=}
                if tags_include_remote "$tag_list"; then
                    return 0
                fi
                ;;
            -tags | --tags)
                expect_tags=true
                ;;
        esac
    done
    return 1
}

command_requires_heavy_lane() {
    seen_go=false
    seen_ginkgo=false
    seen_make=false
    go_test=false
    go_expect_value=false
    go_after_args=false
    package_count=0
    ginkgo_package_count=0

    if [ "${1##*/}" = go ] && [ -n "${GOFLAGS:-}" ] &&
        "$agent_test_go_flags" race "$GOFLAGS"; then
        return 0
    fi

    for argument do
        base=${argument##*/}
        case "$base" in
            go)
                seen_go=true
                ;;
            ginkgo)
                seen_ginkgo=true
                ;;
            make)
                seen_make=true
                ;;
        esac

        if [ "$seen_go" = true ] && [ "$go_test" = false ] &&
            [ "$base" = test ]; then
            go_test=true
            continue
        fi
        if [ "$seen_go" = true ] && [ "$base" = generate ]; then
            return 0
        fi

        if [ "$seen_make" = true ]; then
            case "$argument" in
                test | test-envtest | test-unit | test-race | \
                    test-postdeploy | test-conformance | \
                    verify-generate | check | generate)
                    return 0
                    ;;
            esac
        fi

        if [ "$go_test" = true ]; then
            if [ "$go_after_args" = true ]; then
                continue
            fi
            if [ "$go_expect_value" = true ]; then
                go_expect_value=false
                continue
            fi
            case "$argument" in
                -args)
                    go_after_args=true
                    ;;
                -race | -race=*)
                    return 0
                    ;;
                -C | -asmflags | -bench | -benchtime | -count | \
                    -covermode | -coverpkg | -coverprofile | -cpu | \
                    -exec | -fuzz | -fuzzminimizetime | -fuzztime | \
                    -gcflags | -ldflags | -list | -mod | -modfile | \
                    -o | -overlay | -p | -parallel | -pkgdir | -run | \
                    -shuffle | -tags | -timeout | -toolexec | -vet)
                    go_expect_value=true
                    ;;
                -*)
                    ;;
                *)
                    package_count=$((package_count + 1))
                    case "$argument" in
                        all | std | cmd/... | *...)
                            return 0
                            ;;
                    esac
                    ;;
            esac
        fi

        if [ "$seen_ginkgo" = true ]; then
            case "$argument" in
                -r | --recursive | -p | --procs | --procs=* | \
                    -race | -race=* | --race | --race=*)
                    return 0
                    ;;
                . | ./* | ../*)
                    ginkgo_package_count=$((ginkgo_package_count + 1))
                    case "$argument" in
                        *...)
                            return 0
                            ;;
                    esac
                    ;;
            esac
        fi
    done

    if [ "$go_test" = true ] && [ "$package_count" -gt 1 ]; then
        return 0
    fi
    [ "$seen_ginkgo" = true ] && [ "$ginkgo_package_count" -gt 1 ]
}

if command_is_remote_only "$@"; then
    echo "agent-test-run: run integration, chaos, and TLA+ tests on cloud-dev" >&2
    echo "agent-test-run: copy or update the checkout there, then run:" >&2
    echo "  ssh cloud-dev 'cd <remote-checkout> && <command>'" >&2
    exit 2
fi

if [ "$heavy" = false ] && command_requires_heavy_lane "$@"; then
    heavy=true
fi

if [ "$nested" = true ] && [ -r "/proc/$$/cgroup" ]; then
    test_cgroup=$(cat "/proc/$$/cgroup")
    case "$test_cgroup" in
        *"/nks-agent-tests.slice/nks-agent-heavy-test-"*)
            exec "$@"
            ;;
        *"/nks-agent-tests.slice/"*)
            if [ "$heavy" = false ]; then
                exec "$@"
            fi
            ;;
    esac
fi

invoking_systemd_unit() {
    LC_ALL=C awk -F/ '
        /^0::/ {
            for (field = NF; field > 0; field--) {
                if ($field ~ /\.(scope|service)$/) {
                    print $field
                    exit
                }
            }
        }
    ' "/proc/$$/cgroup"
}

run_named() {
    unit=$1
    shift
    launching=true
    systemd-run \
        --user \
        --quiet \
        --collect \
        --wait \
        --pipe \
        --same-dir \
        --slice=nks-agent-tests.slice \
        --unit="$unit" \
        --service-type=exec \
        --property=KillMode=control-group \
        --property="BindsTo=$owner_unit" \
        --property="After=$owner_unit" \
        -- \
        nice -n 10 ionice -c 3 \
        "$agent_test_env_exec" \
        "$caller_environment" \
        "$caller_command_line" \
        "$command_arg_offset" &
    if [ "${NKS_AGENT_TEST_SIGNAL_DURING_PID_PUBLICATION:-}" = 1 ]; then
        kill -TERM "$$"
    fi
    publish_waiting_pid "$!"
    if wait "$waiting_pid"; then
        rc=0
    else
        rc=$?
    fi
    waiting_pid=
    return "$rc"
}

wait_for_unit() {
    unit=$1
    while state=$(systemctl --user show "$unit" \
        --property=ActiveState \
        --value 2>/dev/null); do
        case "$state" in
            active | activating | reloading | deactivating)
                sleep 0.1
                ;;
            *)
                return
                ;;
        esac
    done
}

active_unit=
waiting_pid=
launching=false
pending_signal_status=

publish_waiting_pid() {
    waiting_pid=$1
    launching=false
    if [ -n "$pending_signal_status" ]; then
        status=$pending_signal_status
        pending_signal_status=
        handle_signal "$status"
    fi
}

stop_waiting_process() {
    if [ -z "$waiting_pid" ]; then
        return
    fi

    pid_to_stop=$waiting_pid
    kill -TERM "$pid_to_stop" >/dev/null 2>&1 || true
    wait "$pid_to_stop" >/dev/null 2>&1 || true
    waiting_pid=
}

stop_active_unit() {
    if [ -z "$active_unit" ]; then
        return
    fi

    unit_to_stop=$active_unit
    systemctl --user stop "$unit_to_stop" >/dev/null 2>&1 || true
    wait_for_unit "$unit_to_stop"
    active_unit=
}

handle_signal() {
    status=$1
    if [ "$launching" = true ]; then
        pending_signal_status=$status
        return
    fi
    trap - HUP INT TERM
    stop_waiting_process
    stop_active_unit
    exit "$status"
}

install_cleanup_traps() {
    trap 'handle_signal 129' HUP
    trap 'handle_signal 130' INT
    trap 'handle_signal 143' TERM
    trap 'stop_active_unit' EXIT
}

run_managed_unit() {
    unit=$1
    shift
    active_unit=$unit
    if run_named "$unit" "$@"; then
        rc=0
    else
        rc=$?
    fi
    wait_for_unit "$unit"
    active_unit=
    return "$rc"
}

owner_unit=$(invoking_systemd_unit)
case "$owner_unit" in
    *.scope | *.service)
        ;;
    *)
        echo "agent-test-run: cannot identify the invoking systemd scope or service" >&2
        exit 1
        ;;
esac

agent_test_env_exec=${NKS_AGENT_TEST_ENV_EXEC:-$(readlink -f \
    "$(dirname "$(readlink -f "$0")")/../libexec/agent-test-env-exec")}
caller_environment="/proc/$$/environ"
caller_command_line="/proc/$$/cmdline"
if [ ! -x "$agent_test_env_exec" ]; then
    echo "agent-test-run: environment launcher is unavailable: $agent_test_env_exec" >&2
    exit 1
fi

if [ "$heavy" = true ]; then
    install_cleanup_traps
    exec 9>/tmp/nks-agent-heavy-test.lock
    launching=true
    flock -w 3600 9 &
    publish_waiting_pid "$!"
    if wait "$waiting_pid"; then
        waiting_pid=
    else
        rc=$?
        waiting_pid=
        exit "$rc"
    fi
    # Keep the lock in this waiting wrapper and close its descriptor before
    # systemd-run starts workload processes. Cancellation stops the named unit
    # before the wrapper exits and releases the lock.
    unit="nks-agent-heavy-test-$$.service"
    if run_managed_unit "$unit" "$@" 9>&-; then
        rc=0
    else
        rc=$?
    fi
    exec 9>&-
    exit "$rc"
fi

install_cleanup_traps
run_managed_unit "nks-agent-test-$$.service" "$@"
