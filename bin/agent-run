#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
    echo "usage: agent-run COMMAND [ARGUMENT ...]" >&2
    exit 2
fi

if ! command -v systemctl >/dev/null 2>&1 || ! command -v systemd-run >/dev/null 2>&1; then
    echo "agent-run: systemd user tools are required" >&2
    exit 1
fi

check_agents_slice() {
    quota=$(systemctl --user show agents.slice \
        --property=CPUQuotaPerSecUSec \
        --value 2>/dev/null) || {
        echo "agent-run: agents.slice is unavailable" >&2
        return 1
    }

    case "$quota" in
        "" | "[not set]" | infinity)
            echo "agent-run: agents.slice does not have a finite CPU limit" >&2
            echo "agent-run: verify CPUQuota in ~/.config/systemd/user/agents.slice" >&2
            return 1
            ;;
        *)
            ;;
    esac

    memory_max=$(systemctl --user show agents.slice \
        --property=MemoryMax \
        --value 2>/dev/null) || {
        echo "agent-run: agents.slice is unavailable" >&2
        return 1
    }

    case "$memory_max" in
        "" | "[not set]" | infinity)
            echo "agent-run: agents.slice does not have a finite memory limit" >&2
            echo "agent-run: verify MemoryMax in ~/.config/systemd/user/agents.slice" >&2
            return 1
            ;;
        *)
            ;;
    esac
}

if ! check_agents_slice 2>/dev/null; then
    # A stale in-memory unit after a dotfiles update is the usual cause of
    # missing limits; reload once before refusing to launch.
    systemctl --user daemon-reload 2>/dev/null || true
    check_agents_slice || exit 1
fi

if ! command -v "$1" >/dev/null 2>&1; then
    echo "agent-run: command not found: $1" >&2
    exit 127
fi

test_shim_dir="$HOME/.dotfiles/libexec/agent-test-shims"
original_path=
old_ifs=$IFS
IFS=:
for path_entry in $PATH; do
    if [ "$path_entry" = "$test_shim_dir" ]; then
        continue
    fi
    if [ -z "$original_path" ]; then
        original_path=$path_entry
    else
        original_path="$original_path:$path_entry"
    fi
done
IFS=$old_ifs
NKS_AGENT_TEST_ORIGINAL_PATH=$original_path
if [ -n "$original_path" ]; then
    PATH="$test_shim_dir:$original_path"
else
    PATH=$test_shim_dir
fi
NKS_AGENT_TEST_SHIMS_ACTIVE=1
export NKS_AGENT_TEST_ORIGINAL_PATH NKS_AGENT_TEST_SHIMS_ACTIVE PATH

exec systemd-run \
    --user \
    --scope \
    --quiet \
    --collect \
    --same-dir \
    --slice=agents.slice \
    -- "$@"
