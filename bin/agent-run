#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
    echo "usage: agent-run COMMAND [ARGUMENT ...]" >&2
    exit 2
fi

if ! command -v systemctl >/dev/null 2>&1 || ! command -v systemd-run >/dev/null 2>&1; then
    echo "agent-run: systemd user tools are required" >&2
    exit 1
fi

check_agents_slice() {
    quota=$(systemctl --user show agents.slice \
        --property=CPUQuotaPerSecUSec \
        --value 2>/dev/null) || {
        echo "agent-run: agents.slice is unavailable" >&2
        return 1
    }

    case "$quota" in
        "" | "[not set]" | infinity)
            echo "agent-run: agents.slice does not have a finite CPU limit" >&2
            echo "agent-run: verify CPUQuota in ~/.config/systemd/user/agents.slice" >&2
            return 1
            ;;
        *)
            ;;
    esac

    memory_max=$(systemctl --user show agents.slice \
        --property=MemoryMax \
        --value 2>/dev/null) || {
        echo "agent-run: agents.slice is unavailable" >&2
        return 1
    }

    case "$memory_max" in
        "" | "[not set]" | infinity)
            echo "agent-run: agents.slice does not have a finite memory limit" >&2
            echo "agent-run: verify MemoryMax in ~/.config/systemd/user/agents.slice" >&2
            return 1
            ;;
        *)
            ;;
    esac
}

if ! check_agents_slice 2>/dev/null; then
    # A stale in-memory unit after a dotfiles update is the usual cause of
    # missing limits; reload once before refusing to launch.
    systemctl --user daemon-reload 2>/dev/null || true
    check_agents_slice || exit 1
fi

if ! command -v "$1" >/dev/null 2>&1; then
    echo "agent-run: command not found: $1" >&2
    exit 127
fi

test_shim_dir="$HOME/.dotfiles/libexec/agent-test-shims"
original_path=
old_ifs=$IFS
IFS=:
for path_entry in $PATH; do
    if [ "$path_entry" = "$test_shim_dir" ]; then
        continue
    fi
    if [ -z "$original_path" ]; then
        original_path=$path_entry
    else
        original_path="$original_path:$path_entry"
    fi
done
IFS=$old_ifs
NKS_AGENT_TEST_ORIGINAL_PATH=$original_path
if [ -n "$original_path" ]; then
    PATH="$test_shim_dir:$original_path"
else
    PATH=$test_shim_dir
fi
NKS_AGENT_TEST_SHIMS_ACTIVE=1
export NKS_AGENT_TEST_ORIGINAL_PATH NKS_AGENT_TEST_SHIMS_ACTIVE PATH

# Keep agent scratch off /tmp. /tmp is a tmpfs sized at half of RAM, and tmpfs
# pages are charged as unevictable shmem against the agents.slice MemoryHigh
# budget — GB-scale envtest and build scratch there pins the slice at its soft
# limit and wedges it in permanent direct reclaim without ever tripping an OOM
# kill. A disk-backed scratch dir is reclaimable page cache instead, so hot
# files stay in RAM without being accounted against the slice.
agent_tmpdir="${XDG_CACHE_HOME:-$HOME/.cache}/agent-tmp"
if mkdir -p "$agent_tmpdir" 2>/dev/null && [ -w "$agent_tmpdir" ]; then
    TMPDIR=$agent_tmpdir
    export TMPDIR
else
    # An unusable scratch dir must not stop an agent from launching; the
    # inherited default is slower to fail but still correct.
    echo "agent-run: cannot use $agent_tmpdir, falling back to ${TMPDIR:-/tmp}" >&2
fi

exec systemd-run \
    --user \
    --scope \
    --quiet \
    --collect \
    --same-dir \
    --slice=agents.slice \
    --setenv=TMPDIR="${TMPDIR:-/tmp}" \
    -- "$@"
