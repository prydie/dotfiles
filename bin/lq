#!/usr/bin/env bash
# Point logcli at a Loki reached through a Grafana datasource proxy.
#
# Why this exists: logcli already does everything worth doing -- query, tail,
# labels, series, stats -- and only needs to be told where to talk to and how
# to authenticate. Where Grafana is published as a Teleport application, both
# answers are better than a port-forward:
#
#   * it needs no Kubernetes access at all, so a viewer role is enough;
#   * Grafana's datasource config supplies the Loki tenant, so there is no
#     X-Scope-OrgID to get wrong -- and a wrong one does not error, it returns
#     empty results, which is indistinguishable from a quiet window;
#   * there is no background process to leak, and nothing to stop afterwards.
#
# `lq up` prints the three variables logcli reads: LOKI_ADDR pointing at the
# datasource proxy, and the Teleport app's client certificate and key.
#
# A cell usually publishes more than one Loki datasource (its own, and often
# separate ones for tenant control planes or audit). `lq datasources` lists
# them; `lq up <app> <uid>` selects one.
#
# Named queries live OUTSIDE this repo, because they encode local schema:
#   ${XDG_CONFIG_HOME:-~/.config}/loki-queries/*.logql
# See config/loki-queries/example.logql.sample for the format.
#
# Usage:
#   eval "$(lq up <app-substring> [datasource-uid])"
#   lq apps                               list Grafana apps
#   lq datasources <app-substring>        list that app's Loki datasources
#   lq queries                            list named queries
#   lq q <name> [args...] [-- logcli-args...]
#   lq completion zsh|bash
#
# Everything else: use logcli directly once `lq up` has been eval'd.
set -euo pipefail

PROG=${0##*/}
APP_PATTERN="${LQ_APP_PATTERN:-grafana}"
QUERY_DIR="${LQ_QUERY_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/loki-queries}"

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

apps() {
  need tsh
  tsh apps ls --format=json 2>/dev/null \
    | python3 -c '
import json,sys
try: apps=json.load(sys.stdin)
except Exception: sys.exit(0)
for a in sorted({x["metadata"]["name"] for x in apps}): print(a)
' || true
}

resolve_app() {
  local want=$1 all matches n
  all=$(apps | grep -- "$APP_PATTERN" || true)
  [ -n "$all" ] || die "no Teleport app matches '$APP_PATTERN' (tsh logged in? set LQ_APP_PATTERN)"
  matches=$(printf '%s\n' "$all" | grep -- "$want" || true)
  n=$(printf '%s\n' "$matches" | grep -c . || true)
  [ "$n" -eq 1 ] && { printf '%s\n' "$matches"; return; }
  [ "$n" -eq 0 ] && die "no app matches '$want'. Try: $PROG apps"
  die "'$want' matched $n apps:
$matches"
}

# Log in if needed and echo "uri<TAB>cert<TAB>key".
app_config() {
  local app=$1 cfg
  cfg=$(tsh apps config --format=json "$app" 2>/dev/null || true)
  if [ -z "$cfg" ]; then
    tsh apps login "$app" >/dev/null 2>&1 || die "tsh apps login $app failed"
    cfg=$(tsh apps config --format=json "$app" 2>/dev/null || true)
  fi
  [ -n "$cfg" ] || die "could not read tsh app config for $app"
  printf '%s' "$cfg" | python3 -c '
import json,sys
d=json.load(sys.stdin)
print("\t".join([d.get("uri",""),d.get("cert",""),d.get("key","")]))
' || die "could not parse tsh app config for $app"
}

curl_app() { # uri cert key path...
  local uri=$1 cert=$2 key=$3; shift 3
  curl -s --max-time 60 --cert "$cert" --key "$key" "$uri$1"
}

cmd_apps() { apps | grep -- "$APP_PATTERN" || die "no app matches '$APP_PATTERN'"; }

cmd_datasources() {
  need curl; need python3
  [ $# -ge 1 ] || die "usage: $PROG datasources <app-substring>"
  local app uri cert key
  app=$(resolve_app "$1")
  IFS=$'\t' read -r uri cert key <<<"$(app_config "$app")"
  curl_app "$uri" "$cert" "$key" "/api/datasources" | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit("lq: Grafana returned unparseable output -- NOT an empty list")
if isinstance(d,dict): sys.exit("lq: Grafana said: %s" % json.dumps(d)[:200])
loki=[x for x in d if x.get("type")=="loki"]
if not loki: sys.exit("lq: this Grafana publishes no Loki datasource")
for x in loki: print("  %-30s %s" % (x["uid"], x["name"]))
'
}

cmd_up() {
  need curl; need python3
  [ $# -ge 1 ] || die "usage: eval \"\$($PROG up <app-substring> [datasource-uid])\""
  local app uri cert key uid="${2:-}"
  app=$(resolve_app "$1")
  IFS=$'\t' read -r uri cert key <<<"$(app_config "$app")"

  # Pick the datasource rather than assume one: a cell commonly publishes
  # several Loki datasources and the wrong one is a plausible empty result.
  if [ -z "$uid" ]; then
    local found
    found=$(curl_app "$uri" "$cert" "$key" "/api/datasources" | python3 -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(1)
if isinstance(d,dict): sys.exit(1)
loki=[x for x in d if x.get("type")=="loki"]
if len(loki)==1: print(loki[0]["uid"])
' || true)
    [ -n "$found" ] || die "more than one (or no) Loki datasource on $app -- name one explicitly.
  See: $PROG datasources $1"
    uid=$found
  fi

  printf 'export LOKI_ADDR=%s/api/datasources/proxy/uid/%s\n' "$uri" "$uid"
  printf 'export LOKI_CLIENT_CERT_PATH=%s\n' "$cert"
  printf 'export LOKI_CLIENT_KEY_PATH=%s\n' "$key"
  printf '# %s -> datasource %s\n' "$app" "$uid"
}

query_files() { ls "$QUERY_DIR"/*.logql 2>/dev/null || true; }

cmd_query_names() {
  local f
  for f in $(query_files); do
    sed -n 's/^\([a-zA-Z0-9_-]\+\)[[:space:]]*|.*/\1/p' "$f"
  done | sort -u
}

cmd_completion() {
  case "${1:-}" in
    zsh) cat <<'ZSH'
#compdef lq
# Generated by `lq completion zsh`. App and query names are asked of lq itself,
# so they follow whatever Teleport apps and query packs are in play.
_lq() {
  local -a subcmds
  subcmds=(
    'up:select a Grafana app and export the logcli variables'
    'apps:list Grafana apps'
    'datasources:list an app'"'"'s Loki datasources'
    'queries:list named queries with their templates'
    'q:run a named query'
    'completion:emit a completion script'
  )
  _arguments -C '1:command:->cmd' '*::arg:->args'
  case $state in
    cmd) _describe -t commands 'lq command' subcmds ;;
    args)
      case $words[1] in
        up|datasources)
          if (( CURRENT == 2 )); then
            local -a a; a=(${(f)"$(lq __apps 2>/dev/null)"}); _describe -t apps 'app' a
          elif [[ $words[1] == up ]]; then
            local -a d; d=(${(f)"$(lq datasources $words[2] 2>/dev/null | awk '{print $1}')"})
            _describe -t datasources 'datasource' d
          fi ;;
        q)  if (( CURRENT == 2 )); then
              local -a n; n=(${(f)"$(lq __query_names 2>/dev/null)"}); _describe -t queries 'query' n
            else _message 'query argument' ; fi ;;
        completion) _values 'shell' zsh bash ;;
      esac ;;
  esac
}
_lq "$@"
ZSH
      ;;
    bash) cat <<'BASH'
# Generated by `lq completion bash`. Source it, or drop it in bash_completion.d.
_lq() {
  local cur; cur=${COMP_WORDS[COMP_CWORD]}
  if [ "$COMP_CWORD" -eq 1 ]; then
    COMPREPLY=($(compgen -W "up apps datasources queries q completion" -- "$cur")); return
  fi
  case "${COMP_WORDS[1]}" in
    up|datasources)
      if [ "$COMP_CWORD" -eq 2 ]; then
        COMPREPLY=($(compgen -W "$(lq __apps 2>/dev/null)" -- "$cur"))
      elif [ "${COMP_WORDS[1]}" = up ]; then
        COMPREPLY=($(compgen -W "$(lq datasources "${COMP_WORDS[2]}" 2>/dev/null | awk '{print $1}')" -- "$cur"))
      fi ;;
    q) [ "$COMP_CWORD" -eq 2 ] && COMPREPLY=($(compgen -W "$(lq __query_names 2>/dev/null)" -- "$cur")) ;;
    completion) COMPREPLY=($(compgen -W "zsh bash" -- "$cur")) ;;
  esac
}
complete -F _lq lq
BASH
      ;;
    *) die "usage: $PROG completion zsh|bash";;
  esac
}

cmd_queries() {
  local f
  [ -n "$(query_files)" ] || die "no query packs in $QUERY_DIR (see config/loki-queries/example.logql.sample)"
  for f in $(query_files); do
    printf '# %s\n' "${f##*/}"
    sed -n 's/^\([a-zA-Z0-9_-]\+\)[[:space:]]*|[[:space:]]*\(.*\)$/  \1\t\2/p' "$f"
  done
}

cmd_q() {
  need logcli
  [ $# -ge 1 ] || die "usage: $PROG q <name> [args...] [-- logcli-args...]"
  local name=$1; shift
  local tmpl="" f
  local -a hits=()
  for f in $(query_files); do
    if sed -n "s/^${name}[[:space:]]*|[[:space:]]*//p" "$f" | grep -q .; then
      hits+=("$f")
      [ -z "$tmpl" ] && tmpl=$(sed -n "s/^${name}[[:space:]]*|[[:space:]]*//p" "$f" | head -1)
    fi
  done
  [ -n "$tmpl" ] || die "no query named '$name' (try: $PROG queries)"
  [ "${#hits[@]}" -le 1 ] || die "'$name' is defined in ${#hits[@]} packs, so which wins depends on filename order: ${hits[*]}"

  local -a passthru=()
  local -a args=()
  local seen_sep=0
  for a in "$@"; do
    if [ "$seen_sep" = 1 ]; then passthru+=("$a")
    elif [ "$a" = "--" ]; then seen_sep=1
    else args+=("$a"); fi
  done

  # Substitute $1..$9 with the positional args, literally -- no shell eval.
  local q=$tmpl n=1
  for a in ${args+"${args[@]}"}; do
    q=${q//\$$n/$a}
    n=$((n+1))
  done
  case "$q" in *'$'[1-9]*) die "query '$name' still has an unsubstituted placeholder: $q";; esac

  [ -n "${LOKI_ADDR:-}" ] || die "LOKI_ADDR unset; run: eval \"\$($PROG up <app>)\""

  # Default to raw output: these are structured logs, so the log line IS the
  # record, and logcli's own timestamp+label prefix only gets in the way of
  # anything downstream that parses JSON (hl, jq). Pass --output explicitly to
  # override. --quiet keeps logcli's own banner off stdout for the same reason.
  case " ${passthru[*]-} " in
    *" --output"*|*" -o "*) ;;
    *) passthru=("--output=raw" ${passthru+"${passthru[@]}"}) ;;
  esac
  case " ${passthru[*]-} " in
    *" --quiet"*) ;;
    *) passthru=("--quiet" ${passthru+"${passthru[@]}"}) ;;
  esac
  printf '%s: %s\n' "$PROG" "$q" >&2
  # logcli exits 0 and prints nothing when a query matches nothing, which is
  # indistinguishable from a healthy quiet window. Say so rather than let an
  # empty screen be read as an absence.
  logcli query ${passthru+"${passthru[@]}"} "$q" | awk '{n++; print} END {
    if (n == 0) {
      print "lq: 0 lines. Loki reports success for a query matching nothing, so this is" > "/dev/stderr"
      print "    an absence ONLY if the window is inside retention and the filter is right." > "/dev/stderr"
      print "    Re-run with the `id` query to check without | json field matching." > "/dev/stderr"
    } else print "lq: " n " lines" > "/dev/stderr"
  }' 
}

case "${1:-}" in
  up)          shift; cmd_up "$@";;
  apps)        shift; cmd_apps "$@";;
  datasources) shift; cmd_datasources "$@";;
  queries)     shift; cmd_queries "$@";;
  q)           shift; cmd_q "$@";;
  completion)  shift; cmd_completion "$@";;
  __query_names) shift; cmd_query_names "$@";;
  __apps)      shift; cmd_apps "$@" 2>/dev/null || true;;
  -h|--help|"") sed -n '2,37p' "$0" | sed 's/^# \{0,1\}//';;
  *) die "unknown subcommand: $1 (try --help)";;
esac
