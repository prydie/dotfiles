#!/usr/bin/env bash
# Run the nscale CLI against a named environment profile.
#
# Why this exists: the CLI takes its endpoints from $ENV, its org/project/region
# from --context, and its credentials from a keyring slot named by --user. Those
# are three independent inputs with nothing tying them together -- contexts.yaml
# has no env field at all -- so a context selected for one environment is sent
# happily to another's endpoints, which is how staging org IDs came to be
# addressed at production URLs. Worse, the keyring slot is keyed on the user
# name alone (internal/auth/credentials.go), and staging and production share an
# organization, so a login without --user overwrites the other environment's
# refresh token. The disk caches for feature flags and completions are keyed the
# same way, so a shared slot also cross-contaminates tab completion.
#
# So: one name binds all three, this always passes them explicitly, and nothing
# is left to ambient state. `nscale contexts clear` once, and keep it cleared.
#
# Profiles live outside this public repo (they name internal contexts):
# ~/.config/nscale/profiles.d/<name>.env -- see config/nscale/profiles.d/*.example.
#
# Usage:
#   nsc <profile> [nscale args...]   run a command in that profile
#   nsc login <profile>              log in to that profile's keyring slot
#   nsc list                         list profiles
#   nsc which                        show the profile active in this shell
#
# `nsc use <profile>` / `nsc unuse` are shell functions (see this repo's
# aliases), because only the calling shell can change its own environment.
set -euo pipefail

PROG=${0##*/}
PROFILE_DIR="${NSC_PROFILE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/nscale/profiles.d}"
DEFAULT_BIN="${NSC_NSCALE_BIN:-$HOME/.local/bin/nscale}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/nsc"

# Leaf verbs that only read. Anything else counts as a change, so an unknown or
# newly added verb is guarded rather than waved through -- see confirm_change.
READ_VERBS=(list get show describe status version help completion token contexts login logout)

die() { printf '%s: %s\n' "$PROG" "$*" >&2; exit 1; }
note() { printf '%s: %s\n' "$PROG" "$*" >&2; }

usage() { sed -n '2,/^set -euo/p' "$0" | sed 's|^# \{0,1\}||;$d'; }

list_profiles() {
  local f base
  [[ -d $PROFILE_DIR ]] || return 0
  for f in "$PROFILE_DIR"/*.env; do
    [[ -e $f ]] || continue
    base=${f##*/}
    printf '%s\n' "${base%.env}"
  done
}

profile_names() { list_profiles | paste -sd' ' -; }

load_profile() {
  local name=$1
  local file="$PROFILE_DIR/$name.env"
  [[ $name == */* || $name == .* ]] && die "invalid profile name '$name'"
  [[ -r $file ]] || die "unknown profile '$name'; have: $(profile_names) (from $PROFILE_DIR)"

  # Cleared first so a key absent from one profile cannot be inherited from the
  # environment, which would silently point a profile at the wrong place.
  NSC_DESC=; NSC_ENV=; NSC_USER=; NSC_CONTEXT=; NSC_BIN=
  NSC_VERCEL_BYPASS_OP=; NSC_TOKEN_FILE=; NSC_CONFIRM=

  set -a
  # shellcheck disable=SC1090  # a per-profile settings file, by design
  . "$file"
  set +a
  NSC_PROFILE=$name
  export NSC_PROFILE
}

expand_home() { printf '%s' "${1/#\~/$HOME}"; }

# The dev and staging consoles sit behind Vercel deployment protection, and the
# CLI needs the bypass secret both to log in and to fetch feature flags. The
# flag cache is fresh for only 15 minutes (internal/featureflags/service.go), so
# a working session re-fetches often, and `op read` costs ~2s every time. Cache
# it in the per-login tmpfs for the same reason and in the same shape as the
# agent GitHub token in zshenv: it never reaches disk and dies with the session.
resolve_bypass() {
  [[ -n ${VERCEL_PROTECTION_BYPASS_SECRET:-} ]] && { export VERCEL_PROTECTION_BYPASS_SECRET; return 0; }
  [[ -n $NSC_VERCEL_BYPASS_OP ]] || return 0

  local cache="$RUNTIME_DIR/vercel-bypass" secret=""
  if [[ -s $cache ]]; then
    secret=$(<"$cache")
  else
    command -v op >/dev/null 2>&1 \
      || die "op not on PATH, needed to read $NSC_VERCEL_BYPASS_OP; or export VERCEL_PROTECTION_BYPASS_SECRET yourself"
    secret=$(op read "$NSC_VERCEL_BYPASS_OP") \
      || die "failed to read the Vercel bypass secret from 1Password ($NSC_VERCEL_BYPASS_OP)"
    [[ -n $secret ]] || die "1Password returned an empty value for $NSC_VERCEL_BYPASS_OP"
    mkdir -p "$RUNTIME_DIR" && chmod 700 "$RUNTIME_DIR"
    (umask 077; printf '%s' "$secret" > "$cache")
  fi
  export VERCEL_PROTECTION_BYPASS_SECRET="$secret"
}

# A service token short-circuits login entirely (internal/auth/credentials.go).
# Read from the file on every call, never copied, so a rotation is picked up
# with no action here.
resolve_token() {
  [[ -n $NSC_TOKEN_FILE ]] || return 0
  if [[ -n ${NSCALE_SERVICE_TOKEN:-} ]]; then export NSCALE_SERVICE_TOKEN; return 0; fi

  local f
  f=$(expand_home "$NSC_TOKEN_FILE")
  [[ -r $f ]] || die "service token file not readable: $f"
  local token
  token=$(tr -d '[:space:]' < "$f")
  [[ -n $token ]] || die "service token file is empty: $f"
  export NSCALE_SERVICE_TOKEN="$token"
}

apply_env() {
  # An absent ENV is what selects production (cmd/config.go's default case), so
  # a profile with no ENV has to actively unset it -- otherwise `nsc prod` run
  # from a shell that did `nsc use stg` would keep talking to staging.
  if [[ -n $NSC_ENV ]]; then export ENV="$NSC_ENV"; else unset ENV; fi
}

# Ask before anything that is not plainly a read, for profiles that opt in with
# NSC_CONFIRM=1. Non-interactive callers are refused rather than waved through:
# a guard that disables itself in exactly the case nobody is watching is no
# guard. --yes or --ci is how a script says it meant it.
confirm_change() {
  [[ ${NSC_CONFIRM:-0} == 1 ]] || return 0

  local a v
  for a in "$@"; do
    case $a in
      --yes|-y|--ci) return 0 ;;
      -*) continue ;;
    esac
    for v in "${READ_VERBS[@]}"; do
      [[ $a == "$v" ]] && return 0
    done
  done

  if [[ ! -t 0 || ! -t 2 ]]; then
    die "refusing a non-read command on profile '$NSC_PROFILE' with no terminal to confirm at; pass --yes if you meant it"
  fi

  printf '%s: profile %s (%s) -- this does not look read-only:\n  nscale %s\n' \
    "$PROG" "$NSC_PROFILE" "${NSC_DESC:-no description}" "$*" >&2
  local reply
  read -r -p "$PROG: continue? [y/N] " reply <&0 || reply=""
  [[ $reply == [yY] ]] || die "aborted"
}

run_profile() {
  local name=$1; shift
  load_profile "$name"
  resolve_bypass
  resolve_token
  apply_env

  local bin
  bin=$(expand_home "${NSC_BIN:-$DEFAULT_BIN}")
  [[ -x $bin ]] || die "nscale binary not found or not executable: $bin (build one with nscale-build)"

  # Inject --context and --user only when the caller named neither, mirroring
  # how the CLI resolves them (--user beats --context beats the context's own
  # user, cmd/prerun.go resolveSelectedUser). That keeps an explicit override
  # working while never leaving the choice to contexts.yaml's `current:`.
  local -a pre=()
  local scoped=0 usered=0 a
  for a in "$@"; do
    case $a in
      --context|--context=*|--org|--org=*) scoped=1 ;;
      --user|--user=*|-u) usered=1 ;;
    esac
  done
  ((scoped)) || [[ -z $NSC_CONTEXT ]] || pre+=(--context "$NSC_CONTEXT")
  ((usered)) || [[ -z $NSC_USER ]] || pre+=(--user "$NSC_USER")

  confirm_change "$@"
  exec "$bin" "${pre[@]}" "$@"
}

# Emitted for `eval` by the nsc shell function: everything run_profile would
# export, so a bare `nscale` in that shell lands in the same place.
shell_export() {
  local name=${1:-}
  [[ -n $name ]] || die "shell-export needs a profile name"
  load_profile "$name"
  resolve_bypass
  resolve_token

  printf 'export NSC_PROFILE=%q\n' "$NSC_PROFILE"
  printf 'export NSC_DESC=%q\n' "$NSC_DESC"
  if [[ -n $NSC_ENV ]]; then
    printf 'export ENV=%q\n' "$NSC_ENV"
  else
    printf 'unset ENV\n'
  fi
  if [[ -n ${VERCEL_PROTECTION_BYPASS_SECRET:-} ]]; then
    printf 'export VERCEL_PROTECTION_BYPASS_SECRET=%q\n' "$VERCEL_PROTECTION_BYPASS_SECRET"
  else
    printf 'unset VERCEL_PROTECTION_BYPASS_SECRET\n'
  fi
  if [[ -n ${NSCALE_SERVICE_TOKEN:-} ]]; then
    printf 'export NSCALE_SERVICE_TOKEN=%q\n' "$NSCALE_SERVICE_TOKEN"
  else
    printf 'unset NSCALE_SERVICE_TOKEN\n'
  fi
}

shell_unexport() {
  printf 'unset NSC_PROFILE NSC_DESC ENV VERCEL_PROTECTION_BYPASS_SECRET NSCALE_SERVICE_TOKEN\n'
}

show_list() {
  [[ -d $PROFILE_DIR ]] || die "no profile directory at $PROFILE_DIR"
  local name auth
  printf 'PROFILE\tENV\tUSER\tCONTEXT\tAUTH\tDESCRIPTION\n'
  while read -r name; do
    [[ -n $name ]] || continue
    # A subshell per profile so one profile's settings cannot leak into the
    # next, and so nothing here disturbs this process's own environment.
    (
      load_profile "$name" >/dev/null
      if [[ -n $NSC_TOKEN_FILE ]]; then
        auth="service-token"
      elif [[ -n $NSC_VERCEL_BYPASS_OP ]]; then
        auth="device+bypass"
      else
        auth="device"
      fi
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
        "$NSC_PROFILE" "${NSC_ENV:--}" "${NSC_USER:--}" \
        "${NSC_CONTEXT:--}" "$auth" "${NSC_DESC:--}"
    )
  done < <(list_profiles)
}

case ${1:-} in
  ""|-h|--help|help) usage; exit 0 ;;
  list|profiles) show_list; exit 0 ;;
  which)
    if [[ -n ${NSC_PROFILE:-} ]]; then
      printf '%s (%s), ENV=%s\n' "$NSC_PROFILE" "${NSC_DESC:-no description}" "${ENV:-<unset, production>}"
    else
      printf 'no nsc profile active in this shell\n'
    fi
    exit 0 ;;
  shell-export) shift; shell_export "$@"; exit 0 ;;
  shell-unexport) shell_unexport; exit 0 ;;
  login)
    shift
    [[ $# -gt 0 ]] || die "login needs a profile name; have: $(profile_names)"
    profile=$1; shift
    run_profile "$profile" login "$@" ;;
  -*) die "unknown option $1 (a profile name comes first; try '$PROG list')" ;;
  *)
    profile=$1; shift
    run_profile "$profile" "$@" ;;
esac
