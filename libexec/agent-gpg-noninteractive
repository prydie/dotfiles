#!/bin/sh

set -eu

for argument do
    case "$argument" in
        -[!-]*s* | -[!-]*S* | --sign | --detach-sign | --clearsign)
            echo "agent-gpg-noninteractive: unattended signing is disabled; commit unsigned and sign the final history when the key is unlocked" >&2
            exit 74
            ;;
    esac
done

exec /usr/bin/gpg --batch --no-tty --pinentry-mode error "$@"
