#!/usr/bin/env python3

import os
import sys
from pathlib import Path


def main() -> int:
    if len(sys.argv) < 3:
        print(
            "agent-test-env-exec: expected ENVIRON_PATH COMMAND [ARGUMENT ...]",
            file=sys.stderr,
        )
        return 2

    environment: dict[str, str] = {}
    for entry in Path(sys.argv[1]).read_bytes().split(b"\0"):
        if not entry:
            continue
        name, separator, value = entry.partition(b"=")
        if not separator:
            continue
        environment[os.fsdecode(name)] = os.fsdecode(value)

    environment["GOMAXPROCS"] = "2"
    environment["GOFLAGS"] = (
        f"{environment.get('GOFLAGS', '').strip()} -p=2".strip()
    )
    os.execvpe(sys.argv[2], sys.argv[2:], environment)


if __name__ == "__main__":
    raise SystemExit(main())
