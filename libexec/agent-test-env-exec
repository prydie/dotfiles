#!/usr/bin/env python3

import os
import shutil
import sys
import time
from pathlib import Path


def main() -> int:
    if len(sys.argv) != 4:
        print(
            "agent-test-env-exec: expected ENVIRON_PATH CMDLINE_PATH ARG_OFFSET",
            file=sys.stderr,
        )
        return 2

    environment: dict[str, str] = {}
    for entry in Path(sys.argv[1]).read_bytes().split(b"\0"):
        if not entry:
            continue
        name, separator, value = entry.partition(b"=")
        if not separator:
            continue
        environment[os.fsdecode(name)] = os.fsdecode(value)

    environment["GOMAXPROCS"] = "2"
    environment["GOFLAGS"] = (
        f"{environment.get('GOFLAGS', '').strip()} -p=2".strip()
    )
    scratch_root = (
        Path(environment.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        / "nks-agent-tests"
    )
    scratch_root.mkdir(mode=0o700, parents=True, exist_ok=True)
    now = time.time()
    for stale in scratch_root.glob("run-*"):
        try:
            if now - stale.stat().st_mtime > 2 * 24 * 60 * 60:
                shutil.rmtree(stale)
        except FileNotFoundError:
            continue
    scratch = scratch_root / f"run-{os.getpid()}"
    scratch.mkdir(mode=0o700)
    environment["TMPDIR"] = str(scratch)
    environment["GOTMPDIR"] = str(scratch)
    command_line = [
        os.fsdecode(argument)
        for argument in Path(sys.argv[2]).read_bytes().split(b"\0")
        if argument
    ]
    try:
        argument_offset = int(sys.argv[3])
    except ValueError:
        print("agent-test-env-exec: ARG_OFFSET must be an integer", file=sys.stderr)
        return 2
    command = command_line[argument_offset:]
    if not command:
        print("agent-test-env-exec: caller command line has no command", file=sys.stderr)
        return 2
    os.execvpe(command[0], command, environment)


if __name__ == "__main__":
    raise SystemExit(main())
