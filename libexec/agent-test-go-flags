#!/usr/bin/env python3

import sys


def split(value: str) -> list[str]:
    fields: list[str] = []
    while value:
        value = value.lstrip(" \t\n\r")
        if not value:
            break
        if value[0] in {"'", '"'}:
            quote = value[0]
            end = value.find(quote, 1)
            if end < 0:
                raise ValueError(f"unterminated {quote} string")
            fields.append(value[1:end])
            value = value[end + 1 :]
            continue
        end = 0
        while end < len(value) and value[end] not in " \t\n\r":
            end += 1
        fields.append(value[:end])
        value = value[end:]
    return fields


def main() -> int:
    if len(sys.argv) != 3 or sys.argv[1] not in {"race", "remote"}:
        print(
            "agent-test-go-flags: expected race|remote GOFLAGS",
            file=sys.stderr,
        )
        return 2

    try:
        flags = split(sys.argv[2])
    except ValueError as error:
        print(f"agent-test-go-flags: {error}", file=sys.stderr)
        return 2

    for flag in flags:
        if sys.argv[1] == "race" and (
            flag in {"-race", "--race"}
            or flag.startswith(("-race=", "--race="))
        ):
            return 0
        if sys.argv[1] == "remote" and flag.startswith(
            ("-tags=", "--tags=")
        ):
            if {"integration", "chaos"} & set(flag.split("=", 1)[1].split(",")):
                return 0
    return 1


if __name__ == "__main__":
    raise SystemExit(main())
