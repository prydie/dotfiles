#!/bin/sh

set -eu

program=${NKS_AGENT_TEST_PROGRAM:-${0##*/}}
shim_dir=$(readlink -f "$(dirname "$0")")
path_to_clean=${NKS_AGENT_TEST_ORIGINAL_PATH:-${PATH:-}}
original_path=
saved_ifs=$IFS
IFS=:
for path_entry in $path_to_clean; do
    if [ "$(readlink -f "$path_entry" 2>/dev/null || true)" = "$shim_dir" ]; then
        continue
    fi
    if [ -z "$original_path" ]; then
        original_path=$path_entry
    else
        original_path="$original_path:$path_entry"
    fi
done
IFS=$saved_ifs
NKS_AGENT_TEST_ORIGINAL_PATH=$original_path
export NKS_AGENT_TEST_ORIGINAL_PATH

real_program=$(PATH=$original_path command -v "$program" 2>/dev/null || true)
if [ -z "$real_program" ]; then
    echo "agent-test-dispatch: command not found outside the agent shim path: $program" >&2
    exit 127
fi

route=false
case "$program" in
    go)
        case "${1:-}" in
            test | generate)
                route=true
                ;;
        esac
        ;;
    make)
        for argument do
            case "$argument" in
                test | test-* | check | generate | verify-generate)
                    route=true
                    break
                    ;;
            esac
        done
        ;;
    ginkgo | tlc)
        route=true
        ;;
    java)
        for argument do
            case "$argument" in
                *tlc2.TLC* | *tla2tools*.jar)
                    route=true
                    break
                    ;;
            esac
        done
        ;;
esac

if [ "$route" = true ]; then
    exec agent-test-run --nested "$real_program" "$@"
fi

exec "$real_program" "$@"
