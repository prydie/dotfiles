# Production. ENV is deliberately empty: an absent ENV is what selects the
# CLI's default endpoint set, which is production.
NSC_DESC="production uni (europe-west4)"
NSC_ENV=
NSC_USER=default
NSC_CONTEXT=<context name from `nscale contexts list`>
# The production console is not behind Vercel protection, so no bypass secret.
NSC_VERCEL_BYPASS_OP=
# Real customer infrastructure: ask before anything that is not a read.
NSC_CONFIRM=1
