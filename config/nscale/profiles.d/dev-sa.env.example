# Development, as a service account, for headless use only.
#
# Prefer the plain `dev` profile. This authenticates as a shared, privileged
# service account, so nothing it does is attributable to a person -- there is no
# per-user audit trail. Keep it for automation that cannot run a device flow,
# and delete it if nothing needs that.
#
# NSC_USER is empty on purpose: a service token short-circuits the keyring, so
# naming a slot here would be misleading.
NSC_DESC="uni-dev as the shared automation service account"
NSC_ENV=dev
NSC_USER=
NSC_CONTEXT=<context name from `nscale contexts list`>
NSC_TOKEN_FILE=<path to the token file, e.g. ~/.config/nks/...>
NSC_CONFIRM=0
