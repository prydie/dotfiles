# Development. Same shape as staging: a real console behind Vercel deployment
# protection, so the stock binary plus the bypass secret is all it takes. The
# same bypass secret works for dev and staging.
NSC_DESC="uni-dev"
NSC_ENV=dev
NSC_USER=dev
NSC_CONTEXT=<context name from `nscale contexts list`>
NSC_VERCEL_BYPASS_OP="op://<vault>/<item>/<field>"
NSC_CONFIRM=0
