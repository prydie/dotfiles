# Staging. Its console is behind Vercel deployment protection, so the bypass
# secret is needed both to log in and to refresh feature flags.
NSC_DESC="staging (europe-west2)"
NSC_ENV=stg
NSC_USER=stg
NSC_CONTEXT=<context name from `nscale contexts list`>
NSC_VERCEL_BYPASS_OP="op://<vault>/<item>/<field>"
NSC_CONFIRM=0
