[Unit]
Description=LiteLLM proxy serving GLM to Claude Code over the Anthropic API
After=network-online.target
Wants=network-online.target

[Service]
# Provider key and proxy master key; machine-local, mode 600, never tracked.
# See config/litellm/env.example in ~/.dotfiles for the shape.
EnvironmentFile=%h/.config/litellm/env
# The mise shim needs mise on PATH, which a user unit does not inherit.
Environment="PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/bin:/bin"
ExecStart=%h/.local/share/mise/shims/litellm --host 127.0.0.1 --port 4000 --config %h/.config/litellm/config.yaml
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
