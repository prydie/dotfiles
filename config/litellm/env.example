# Machine-local secrets for the litellm proxy service and bin/claude-glm.
# Copy to ~/.config/litellm/env, mode 600. The real file is NOT tracked.
#
# GLM_TEST_API_KEY    the provider key — the same value ~/.zshenv.local
#                     exports for opencode (1Password: GLM-TEST-API-KEY).
# LITELLM_MASTER_KEY   a local token the proxy requires and bin/claude-glm
#                     presents; generate one with:
#                     printf 'sk-%s\n' "$(openssl rand -hex 24)"
# LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES=1
#                     litellm sends OpenAI-backed /v1/messages requests to the
#                     Responses API (/v1/responses) by default; vLLM serves only
#                     /v1/chat/completions, so route there instead.
GLM_TEST_API_KEY=sk-...
LITELLM_MASTER_KEY=sk-...
LITELLM_USE_CHAT_COMPLETIONS_URL_FOR_ANTHROPIC_MESSAGES=1
